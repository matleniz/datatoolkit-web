{
  "additionalProperties": false,
  "properties": {
    "columns": {
      "description": "Text columns to normalize",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Columns",
      "type": "array",
      "x-dtk-dtype": "any",
      "x-dtk-source": "step",
      "x-dtk-widget": "columns"
    },
    "strip": {
      "default": true,
      "description": "Strip surrounding whitespace",
      "title": "Strip",
      "type": "boolean"
    },
    "lower": {
      "default": false,
      "description": "Lowercase",
      "title": "Lower",
      "type": "boolean"
    },
    "unify_separators": {
      "default": false,
      "description": "Turn '-', '_', '.' and repeated spaces into a single space (then strip), so 'site-a' / 'site_a' / 'Site  A' collapse together",
      "title": "Unify Separators",
      "type": "boolean"
    },
    "mapping": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Variant -> canonical value, matched after strip / lower / unify_separators",
      "title": "Mapping",
      "type": "object"
    }
  },
  "required": [
    "columns"
  ],
  "title": "StandardizeTextParams",
  "type": "object"
}